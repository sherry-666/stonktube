{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": ".",
    "rootDirs": [".", ".react-router/types"],
    "noEmit": true,
    "types": ["@react-router/node", "vite/client"]
  },
  "include": ["src", "react-router.config.ts", ".react-router/types/**/*"]
}
